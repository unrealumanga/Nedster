# Copy to ~/.nedster/config.toml, or let `nedster setup` create it.
[models]
ollama_url = "http://127.0.0.1:11434"
router = "nedster-router"
coder = "nedster-worker"
reasoner = "nedster-worker"
critic = "nedster-worker"
embedding = "embeddinggemma:300m-qat-q4_0"
router_keep_alive = "5m"
worker_keep_alive = "90s"
local_thinking = true

# Local-only is the default. This optional oracle is never required.
cloud_oracle_enabled = false
cloud_model = "gpt-5.6-sol"
cloud_reasoning_effort = "high"
cloud_reasoning_mode = "standard"
cloud_reasoning_context = "current_turn"

[sandbox]
backend = "auto"
network = "deny"
max_seconds = 120
max_output_chars = 100000
allow_unsafe_fallback = false
docker_image = "python:3.13-slim"
firecracker_wrapper = ""

[policy]
autonomous = false
max_auto_risk = "write"
allowed_commands = ["python", "python3", "pytest", "git", "rg", "ruff", "uv", "npm", "node", "cargo", "go"]
denied_fragments = ["rm -rf /", "Remove-Item -Recurse", "format ", "mkfs", "shutdown", "reboot", ":(){:|:&};:"]

[runtime]
state_dir = "~/.nedster/runtime"
max_worker_turns = 8
max_parallel_workers = 2
profile = "balanced"
ledger_key_env = "NEDSTER_LEDGER_KEY"
